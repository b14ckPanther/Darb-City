{
  "name": "@darb/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/main.js)",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma generate && tsx src/seed/run.ts",
    "search:reindex": "prisma generate && tsx src/search/reindex.ts",
    "search:quality": "prisma generate && vitest run --config vitest.quality.config.ts",
    "search:record": "prisma generate && tsx scripts/record-intents.ts",
    "admin:grant": "prisma generate && tsx src/auth/grant-cli.ts",
    "web:revalidate": "tsx src/admin/revalidate-all.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@clerk/backend": "catalog:",
    "@darb/contracts": "workspace:*",
    "@darb/core": "workspace:*",
    "@darb/search-text": "workspace:*",
    "@darb/seed": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@ts-rest/core": "catalog:",
    "@ts-rest/nest": "catalog:",
    "ajv": "catalog:",
    "aws4fetch": "catalog:",
    "bullmq": "catalog:",
    "dotenv": "catalog:",
    "ioredis": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "sharp": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "pg": "catalog:",
    "prisma": "catalog:",
    "supertest": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
