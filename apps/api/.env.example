DATABASE_URL=postgresql://darb:darb@localhost:5433/darb
TEST_DATABASE_URL=postgresql://darb:darb@localhost:5433/darb_test
# E2E_DATABASE_URL= (web e2e only, read by apps/web/playwright.config.ts from the shell, not this file;
#   must end in _e2e or _test, e.g. postgresql://darb:darb@localhost:5433/darb_e2e)
PORT=4000
WEB_ORIGIN=http://localhost:3000
REDIS_URL=redis://localhost:6380
# The web server forwards the visitor's IP with this shared key (apps/web SEARCH_PROXY_KEY).
SEARCH_PROXY_KEY=dev-proxy-key
# Hops of reverse proxies in front of the API (Railway: 1).
TRUST_PROXY=0
# IP_HASH_SALT=  (production: required, at least 32 random characters; the rate limiter stores only salted hashes)
# Smart search. Without keys, intent is off (lane 1 only) and embeddings are an offline hash.
# INTENT_PROVIDER=  (anthropic | recorded | off; default: anthropic with a key, else off)
# EMBEDDING_PROVIDER=  (voyage | hash; default: voyage with a key, else hash)
# ANTHROPIC_API_KEY=
# INTENT_MODEL=claude-haiku-5-5
# VOYAGE_API_KEY=
# EMBEDDING_MODEL=voyage-4-lite
# SEARCH_REPORT_KEY=  (Plan 4's admin reads /search/report with it; unset: 404)
# Admin auth (Clerk, admin only in v1). Without a key the admin API answers 401 to everyone.
# CLERK_SECRET_KEY=
# CLERK_JWT_KEY=  (PEM public key from Clerk > API keys; verifies with no network call)
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# AUTH_VERIFIER=  (clerk | fake | off; fake = tests and local e2e only, refused in production)
# ADMIN_EMAILS=  (comma list; granted admin at first sign-in when the email is verified)
# The web route the API calls after each admin write (apps/web REVALIDATE_SECRET must match).
REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me
# Global model budget (lane 2 falls back to lane 1 beyond it), negative cache, suggest limit, log retention.
# MODEL_CALLS_PER_MINUTE=60
# MODEL_CALLS_PER_DAY=5000
# INTENT_NEGATIVE_CACHE_SECONDS=3600
# SUGGEST_RATE_LIMIT=240
# SEARCH_LOG_RETENTION_DAYS=90
# The /contact form. Every message is stored for the admin inbox; with a Resend key it is also mailed.
# RESEND_API_KEY=  (unset: no mail is sent, logged once)
# MAIL_FROM=Darb <hello@darb.co.il>  (a sender on a domain verified in Resend)
# MAIL_TO=founder@darb.co.il
# INQUIRY_RATE_LIMIT=5  (messages per visitor per window)
# INQUIRY_RATE_WINDOW_SECONDS=600
# The /join form. Without a model key the lookup still reads map links and asks OpenStreetMap;
# without R2 the form hides its photo step.
# JOIN_AI=  (anthropic | off; default: anthropic with ANTHROPIC_API_KEY)
# JOIN_MODEL=claude-sonnet-5-5
# JOIN_LOOKUPS_PER_DAY=300  (model lookups a day, all visitors)
# JOIN_LOOKUP_RATE_LIMIT=6  JOIN_RATE_LIMIT=3  JOIN_UPLOAD_RATE_LIMIT=30  (per visitor per hour)
# JOIN_GEOCODER=  (nominatim | off)
# Add from the street (admin): reading a shop sign from a photo. Same ANTHROPIC_API_KEY; each read
# also counts against MODEL_CALLS_PER_MINUTE / MODEL_CALLS_PER_DAY.
# FIELD_AI=  (anthropic | off; default: anthropic with ANTHROPIC_API_KEY. fake: e2e only)
# FIELD_MODEL=claude-sonnet-5-5
# FIELD_READS_PER_DAY=200  (sign reads a day, all admins)
# FIELD_TIMEOUT_MS=30000
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OVERPASS_URL=https://overpass-api.de/api/interpreter  (admin Find the place: house numbers; off with JOIN_GEOCODER=off)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_MEDIA_BUCKET=darb-media
# MEDIA_URL=https://media.darb.co.il
