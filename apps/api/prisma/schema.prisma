generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum PlaceType {
  country
  region
  city
  town
  village
  neighbourhood
}

enum PlaceStatus {
  live
  soon
}

enum KindStatus {
  active
  hidden
}

enum Template {
  menu
  booking
  shop
  portfolio
  listing
  schedule
  quote
  donate
  tracker
  pass
  builder
  station
}

enum Tier {
  example
  basic
  verified
  darb
}

/// Facts about a whole business (packages/core DIETARY). gluten_free: the entire kitchen is
/// gluten-free, safe for celiac disease; never "has a gluten-free option".
enum Dietary {
  gluten_free
}

enum BusinessSource {
  seed
  self
  claimed
  admin
}

enum BusinessStatus {
  draft
  published
  suspended
}

enum ClaimMethod {
  phone
  documents
}

enum ClaimStatus {
  pending
  approved
  rejected
}

enum OrgRole {
  owner
  staff
}

enum PlanStatus {
  live
  hidden
}

enum SearchEntity {
  place
  kind
  business
}

enum SearchLane {
  smart
  instant
  blocked
}

model Place {
  id         String                                       @id @default(uuid(7)) @db.Uuid
  slug       String                                       @unique
  type       PlaceType
  parentId   String?                                      @db.Uuid
  parent     Place?                                       @relation("PlaceTree", fields: [parentId], references: [id])
  children   Place[]                                      @relation("PlaceTree")
  /// Ancestry as "/israel/north/haifa/" for subtree queries.
  path       String
  name       Json
  aliases    String[]
  lat        Float
  lng        Float
  /// Generated from lat/lng in the migration; never written by Prisma.
  /// The default mirrors the generated column's expression so Prisma sees no drift.
  point      Unsupported("geography(Point,4326)")?        @default(dbgenerated("(st_setsrid(st_makepoint(lng, lat), 4326))::geography"))
  boundary   Unsupported("geography(MultiPolygon,4326)")?
  population Int?
  cbsCode    String?                                      @unique
  status     PlaceStatus                                  @default(soon)
  /// Set by every admin write; null means the seed loader owns the row (Plan 4).
  editedAt   DateTime?
  businesses Business[]

  @@index([point], type: Gist)
  @@index([path])
  @@index([status])
}

model Sector {
  id       String    @id @default(uuid(7)) @db.Uuid
  slug     String    @unique
  name     Json
  tagline  Json
  accent   String
  order    Int
  /// Set by every admin write; null means the seed loader owns the row (Plan 4).
  editedAt DateTime?
  kinds    Kind[]
}

model Kind {
  id            String         @id @default(uuid(7)) @db.Uuid
  slug          String         @unique
  sectorId      String         @db.Uuid
  sector        Sector         @relation(fields: [sectorId], references: [id])
  parentKindId  String?        @db.Uuid
  parent        Kind?          @relation("KindTree", fields: [parentKindId], references: [id])
  children      Kind[]         @relation("KindTree")
  name          Json
  synonyms      Json
  template      Template
  contentSchema Json
  attributes    String[]
  icon          String?
  order         Int
  status        KindStatus     @default(active)
  /// Set by every admin write; null means the seed loader owns the row (Plan 4).
  editedAt      DateTime?
  primaryFor    Business[]     @relation("PrimaryKind")
  businesses    BusinessKind[]

  @@index([sectorId])
}

model Brand {
  id         String     @id @default(uuid(7)) @db.Uuid
  slug       String     @unique
  name       Json
  businesses Business[]
}

model Business {
  id             String                                @id @default(uuid(7)) @db.Uuid
  slug           String
  name           Json
  tagline        Json
  primaryKindId  String                                @db.Uuid
  primaryKind    Kind                                  @relation("PrimaryKind", fields: [primaryKindId], references: [id])
  kinds          BusinessKind[]
  placeId        String                                @db.Uuid
  place          Place                                 @relation(fields: [placeId], references: [id])
  lat            Float
  lng            Float
  /// Generated from lat/lng in the migration; never written by Prisma.
  /// The default mirrors the generated column's expression so Prisma sees no drift.
  point          Unsupported("geography(Point,4326)")? @default(dbgenerated("(st_setsrid(st_makepoint(lng, lat), 4326))::geography"))
  address        Json
  phone          String?
  whatsapp       String?
  website        String?
  photos         Json                                  @default("[]")
  /// { key } of the owner's logo in the media bucket; null when there is none.
  logo           Json?
  /// { instagram?, facebook?, tiktok?, waze? }: full https URLs (website keeps its own column).
  links          Json                                  @default("{}")
  /// { accent?, icons? }: the card's look, from core CARD_ACCENTS and CARD_ICON_STYLES.
  cardStyle      Json                                  @default("{}")
  hours          Json
  attributes     Json                                  @default("{}")
  dietary        Dietary[]                             @default([])
  experience     Json
  tier           Tier
  apps           Json                                  @default("{}")
  source         BusinessSource
  status         BusinessStatus                        @default(draft)
  /// Set by every admin write; null means the seed loader owns the row (Plan 4).
  editedAt       DateTime?
  brandId        String?                               @db.Uuid
  brand          Brand?                                @relation(fields: [brandId], references: [id])
  organizationId String?                               @db.Uuid
  organization   Organization?                         @relation(fields: [organizationId], references: [id])
  claims         Claim[]
  joinRequests   JoinRequest[]
  offerings      SearchOffering[]
  createdAt      DateTime                              @default(now())
  updatedAt      DateTime                              @updatedAt

  @@unique([placeId, slug])
  @@index([point], type: Gist)
  @@index([primaryKindId])
  @@index([status])
  @@index([attributes(ops: JsonbPathOps)], type: Gin)
  @@index([dietary], type: Gin)
}

model BusinessKind {
  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kindId     String   @db.Uuid
  kind       Kind     @relation(fields: [kindId], references: [id])

  @@id([businessId, kindId])
  @@index([kindId])
}

model Organization {
  id         String       @id @default(uuid(7)) @db.Uuid
  clerkOrgId String       @unique
  name       String
  members    Membership[]
  businesses Business[]
}

model User {
  id          String       @id @default(uuid(7)) @db.Uuid
  clerkUserId String       @unique
  locale      String       @default("he")
  isAdmin     Boolean      @default(false)
  memberships Membership[]
  claims      Claim[]      @relation("ClaimUser")
  reviewed    Claim[]      @relation("ClaimReviewer")
  audits      AuditLog[]
}

model Membership {
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgRole

  @@id([organizationId, userId])
}

model Claim {
  id           String      @id @default(uuid(7)) @db.Uuid
  businessId   String      @db.Uuid
  business     Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId       String      @db.Uuid
  user         User        @relation("ClaimUser", fields: [userId], references: [id])
  method       ClaimMethod
  status       ClaimStatus @default(pending)
  reviewedById String?     @db.Uuid
  reviewedBy   User?       @relation("ClaimReviewer", fields: [reviewedById], references: [id])
  createdAt    DateTime    @default(now())
  reviewedAt   DateTime?
}

/// A pricing plan on /pricing. Prices are whole shekels; a null monthly price is "Let's talk".
model Plan {
  id          String     @id @default(uuid(7)) @db.Uuid
  slug        String     @unique
  order       Int
  status      PlanStatus @default(live)
  name        Json
  tagline     Json
  /// Per month in whole ILS; 0 is free, null is a custom quote.
  monthly     Int?
  /// One-time setup fee in whole ILS, when there is one.
  setup       Int?
  /// "per month", "from": shown beside the price. {} when there is none.
  priceNote   Json
  /// One list per language: { he: string[], ar: string[], en: string[] }.
  features    Json
  highlighted Boolean    @default(false)
  ctaLabel    Json
  ctaHref     String
  /// The plan's own small print. {} when there is none.
  finePrint   Json
  /// Set by every admin write; null means the seed loader owns the row (Plan 4).
  editedAt    DateTime?

  @@index([status, order])
}

/// Page copy the admin edits, by key ("pricing.title"). The code owns the slots, never the words.
model SiteText {
  id       String    @id @default(uuid(7)) @db.Uuid
  key      String    @unique
  value    Json
  /// Set by every admin write; null means the seed loader owns the row (Plan 4).
  editedAt DateTime?
}

/// Spec §4.6: one per place, kind and published business. Rebuilt by the search-index jobs.
model SearchDocument {
  id           String                                @id @default(uuid(7)) @db.Uuid
  entityType   SearchEntity
  entityId     String                                @db.Uuid
  slug         String
  /// A place's own path, a business's place path, "" for kinds. Paths end with "/".
  placePath    String
  kindIds      String[]                              @db.Uuid
  attributes   Json                                  @default("{}")
  tier         Tier?
  lat          Float?
  lng          Float?
  /// Generated from lat/lng in the migration; never written by Prisma.
  point        Unsupported("geography(Point,4326)")? @default(dbgenerated("(st_setsrid(st_makepoint(lng, lat), 4326))::geography"))
  /// Normalized names in every language (packages/search-text normalize), for suggestions.
  nameText     String
  /// Every normalized field, for trigram and full-text matching.
  text         String
  /// Generated from text in the migration.
  tsv          Unsupported("tsvector")?              @default(dbgenerated("to_tsvector('simple'::regconfig, text)"))
  embedding    Unsupported("vector(512)")?
  /// sha256 of the embedded text and model; an unchanged hash keeps the stored vector (Plan 4).
  embedHash    String?
  completeness Float                                 @default(0)
  updatedAt    DateTime                              @updatedAt

  @@unique([entityType, entityId])
  @@index([placePath])
  // Declared so the drift check matches the migration's hand-written GIN/GiST indexes.
  @@index([text(ops: raw("gin_trgm_ops"))], map: "SearchDocument_text_trgm_idx", type: Gin)
  @@index([nameText(ops: raw("gin_trgm_ops"))], map: "SearchDocument_nameText_trgm_idx", type: Gin)
  @@index([tsv], type: Gin)
  @@index([kindIds], type: Gin)
  @@index([point], type: Gist)
}

/// One thing a published business offers, from its card: an item, a part of an item's list
/// ("shawarma" in "sandwiches: schnitzel, kebab, shawarma"), a tag, its tagline or a kind it is.
/// Rebuilt with the business's search document; filter columns are copied from the business.
model SearchOffering {
  id         String                                @id @default(uuid(7)) @db.Uuid
  businessId String                                @db.Uuid
  business   Business                              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Where on the card it comes from: "items.2", "items.0.meta.1", "tags.0", "tagline", "kind:grill".
  ref        String
  /// item | part | tag | tagline | kind (search/offerings.ts); a part keeps its item as context.
  source     String
  label      Json
  context    Json?
  /// The label, normalized, in every language.
  labelText  String
  /// The label, its context and (for a kind) its synonyms, normalized, in every language.
  text       String
  /// Generated from text in the migration.
  tsv        Unsupported("tsvector")?              @default(dbgenerated("to_tsvector('simple'::regconfig, text)"))
  /// The SearchEmbedding row of this offering's text (shared by every offering with that text).
  embedHash  String?
  placePath  String
  kindIds    String[]                              @db.Uuid
  attributes Json                                  @default("{}")
  dietary    Dietary[]                             @default([])
  tier       Tier
  lat        Float
  lng        Float
  /// Generated from lat/lng in the migration; never written by Prisma.
  point      Unsupported("geography(Point,4326)")? @default(dbgenerated("(st_setsrid(st_makepoint(lng, lat), 4326))::geography"))
  updatedAt  DateTime                              @updatedAt

  @@unique([businessId, ref])
  @@index([embedHash])
  @@index([text(ops: raw("gin_trgm_ops"))], map: "SearchOffering_text_trgm_idx", type: Gin)
  @@index([labelText(ops: raw("gin_trgm_ops"))], map: "SearchOffering_labelText_trgm_idx", type: Gin)
  @@index([tsv], type: Gin)
  @@index([kindIds], type: Gin)
  @@index([dietary], type: Gin)
  @@index([point], type: Gist)
  @@index([placePath])
}

/// One vector per distinct embedded text: thousands of showroom cards share their offerings, so
/// a text is embedded (and stored) once. Rows no offering uses are removed by a full reindex.
/// No vector index, like SearchDocument: distinct texts are few (thousands), so a query scores
/// them all, and Prisma cannot declare an HNSW index without failing the drift check.
model SearchEmbedding {
  /// sha256 of the embedding provider's name and the text (the offering's embedHash).
  hash      String                     @id
  embedding Unsupported("vector(512)")
  createdAt DateTime                   @default(now())
}

/// Spec §4.7: anonymous. No IP, user, user agent or coordinates, ever.
model SearchQuery {
  id          String     @id @default(uuid(7)) @db.Uuid
  normalized  String
  locale      String
  intent      Json
  /// Lane-1 words no strong kind or place match used (feeds the Missing places report).
  unmatched   String[]
  lane        SearchLane
  resultCount Int
  clickedKey  String?
  createdAt   DateTime   @default(now())

  @@index([createdAt])
}

enum InquiryTopic {
  general
  join
  plan
  other
}

enum InquiryStatus {
  new
  handled
}

/// A message from the /contact form: the admin inbox, also mailed to the founder.
model Inquiry {
  id           String        @id @default(uuid(7)) @db.Uuid
  name         String
  /// A phone number or an email address, as typed.
  contact      String
  businessName String?
  topic        InquiryTopic
  /// The plan's slug when the form was opened from a plan's button (?plan=).
  plan         String?
  message      String
  locale       String
  /// Salted hash of the sender's IP bucket (as the rate limiter keys it), never the IP itself.
  ipHash       String?
  status       InquiryStatus @default(new)
  /// When the mail to the founder was accepted; null when mail is off or it failed.
  emailedAt    DateTime?
  createdAt    DateTime      @default(now())

  @@index([status, createdAt])
}

enum JoinSource {
  lookup
  manual
}

enum JoinStatus {
  pending
  approved
  rejected
}

/**
 * A business owner's /join form: the business itself waits as a draft (source self) until the
 * admin approves it. A rejection deletes the draft; the request stays, with its reason.
 */
model JoinRequest {
  id           String     @id @default(uuid(7)) @db.Uuid
  /// Null once a rejection deleted the draft.
  businessId   String?    @db.Uuid
  business     Business?  @relation(fields: [businessId], references: [id], onDelete: SetNull)
  /// The business's name as sent, so a rejected request still says what it was.
  businessName Json
  ownerName    String
  ownerPhone   String
  ownerEmail   String?
  note         String?
  locale       String
  source       JoinSource
  /// What the lookup suggested (no page content, only the fields and their source URLs).
  lookup       Json?
  status       JoinStatus @default(pending)
  rejectReason String?
  /// Salted hash of the sender's IP bucket (as the rate limiter keys it), never the IP itself.
  ipHash       String?
  createdAt    DateTime   @default(now())
  decidedAt    DateTime?

  @@index([status, createdAt])
  @@index([businessId])
}

enum AuditAction {
  create
  update
  status
  release
  delete
}

enum AuditEntity {
  place
  sector
  kind
  business
  plan
  text
}

/// Who changed what, and when. Field names only: values live in the rows themselves.
model AuditLog {
  id         String      @id @default(uuid(7)) @db.Uuid
  at         DateTime    @default(now())
  actorId    String      @db.Uuid
  actor      User        @relation(fields: [actorId], references: [id])
  action     AuditAction
  entityType AuditEntity
  entityId   String      @db.Uuid
  fields     String[]

  @@index([entityType, entityId, at])
  @@index([at])
}
