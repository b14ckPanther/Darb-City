API_URL=http://localhost:4000
SITE_URL=http://localhost:3000
# Shared with apps/api REVALIDATE_SECRET. Production: at least 32 random characters (the server refuses less).
REVALIDATE_SECRET=change-me
# SITE_INDEXABLE=1  (self-hosted production only; Vercel indexes only VERCEL_ENV=production)
# Map tiles. MAP_TILES_DIR holds israel.pmtiles for /api/tiles (default .tiles; create it with
# `pnpm --filter @darb/web tiles:israel`). NEXT_PUBLIC_MAP_TILES_URL overrides the tiles URL at
# build time (R2 in production).
# MAP_TILES_DIR=.tiles
# NEXT_PUBLIC_MAP_TILES_URL=
# A production build without NEXT_PUBLIC_MAP_TILES_URL has no map unless this is 1 (e2e, CI and
# self-hosting with MAP_TILES_DIR).
NEXT_PUBLIC_LOCAL_TILES=1
# Shared with the API (apps/api SEARCH_PROXY_KEY): lets the API rate-limit by the visitor's IP.
# Production refuses to start without it (at least 32 random characters off localhost).
SEARCH_PROXY_KEY=dev-proxy-key
# Admin (Clerk, admin only). Without these keys /admin says sign-in is not set up.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# Local e2e only (refused unless SITE_URL is localhost): fake admin sign-in.
# ADMIN_FAKE_AUTH=1
